# Netlify / Cloudflare Pages redirects.
# Old WordPress blog URLs -> anchors on the single Updates page.

/blog                        /updates/                                  301
/blog/*                      /updates/                                  301
/4-new-additions-in-jan-2025 /updates/#4-new-additions-in-jan-2025      301
/3-new-nps-additions         /updates/#3-new-nps-additions              301
/coming-soon                 /updates/#coming-soon                      301

# Category, tag, author and feed archives WordPress used to serve.
/category/*                  /updates/                                  301
/tag/*                       /updates/                                  301
/author/*                    /                                          301
/feed                        /updates/                                  301
/comments/feed               /updates/                                  301

# Anything still pointing at WordPress internals.
/wp-admin/*                  /                                          301
/wp-login.php                /                                          301
